# ===========================================
# LUNAI Production Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# Domain Configuration
DOMAIN=yourdomain.com
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# DeepSeek API Key (optional, for alternative LLM)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Default LLM Provider (openai or deepseek)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_TOKEN_LIMIT=2000

# User Token Allowance (tokens per user)
USER_TOKEN_ALLOWANCE=50000

# Resend API Key (for email notifications)
RESEND_API_KEY=re_your-resend-api-key
ADMIN_EMAIL=admin@yourdomain.com

# MinIO Object Storage
MINIO_ACCESS_KEY=lunai
MINIO_SECRET_KEY=your-secure-minio-password-change-this

# File Upload Limit (50MB default)
MAX_FILE_SIZE=52428800
